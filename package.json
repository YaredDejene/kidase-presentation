{
  "name": "kidase-presentation-monorepo",
  "private": true,
  "version": "1.0.17",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "desktop": "pnpm --filter desktop dev",
    "api": "pnpm --filter api dev",
    "web": "pnpm --filter web dev",
    "web:dev": "pnpm --parallel --filter api --filter web run dev",
    "sync:desktop": "pnpm --filter api sync-desktop",
    "seed": "pnpm --filter api seed",
    "build": "pnpm --filter desktop build",
    "preview": "pnpm --filter desktop preview",
    "tauri": "pnpm --filter desktop tauri",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "image-size": "^2.0.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
