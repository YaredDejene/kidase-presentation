{
  "name": "api",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-desktop": "python3 scripts/sync-desktop.py /tmp/desktop.kidase && tsx src/seed.ts /tmp/desktop.kidase",
    "dev:memory": "tsx src/devMemory.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@kidase/shared": "workspace:*",
    "@scalar/fastify-api-reference": "^1.25.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.8",
    "mongodb": "^6.13.0",
    "tsx": "^4.19.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "mongodb-memory-server": "^10.1.4",
    "typescript": "~5.8.3",
    "vitest": "^4.0.18"
  }
}
