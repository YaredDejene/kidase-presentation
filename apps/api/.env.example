# Copy to apps/api/.env and adjust. Loaded automatically by the dev/start/seed scripts.

# MongoDB connection. Local examples:
#   - bundled docker-compose (root/local_dev): mongodb://root:local_dev@localhost:27017/?authSource=admin
#   - plain local mongod (no auth):            mongodb://localhost:27017
#   - MongoDB Atlas:                           mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://root:local_dev@localhost:27017/?authSource=admin
MONGODB_DB=kidase

# HTTP server
PORT=3001
HOST=0.0.0.0

# Public render cache TTL (seconds) advertised via Cache-Control
RENDER_MAX_AGE=60
# Rate limit (requests per minute per IP)
RATE_LIMIT_MAX=120

# Admin auth (protects /admin/* — change these in production)
ADMIN_EMAIL=admin@church.org
ADMIN_PASSWORD=changeme
JWT_SECRET=dev-insecure-secret-change-me
